# Scenario toggles — set to true/false to enable/disable each scenario
deploy_vm=false
deploy_webapp=true

resource_group_name="devops_rg"
location="Sweden Central"
vm_size="Standard_B2s"
sub_id="XXXXXX"
ssh_public_key="XXX"
email="XXX"
vnet_name="devopsrg-vnet"
vnet_address_space="10.0.0.0/16"
subnet_name="devopsrg-subnet"
subnet_address_prefix="10.0.1.0/24"
public_ip_name="devopsrg-web-pip"
nsg_name="devopsrg-nsg"
nic_name="devopsrg-web-nic"
vm_name="devopsrg-web-vm"
os_disk_name="devopsrg-web-os-disk"

# CaaS / App Service – Spring Boot
app_service_plan_name="devopsrg-plan"
app_service_plan_sku="B1"
webapp_name="devopsrg-springboot"
container_image="ghcr.io/tsadimas/ds-lab-2024:89f2882-11"
container_registry_url="https://ghcr.io"
container_registry_username=""
container_registry_password=""
container_port=8080

# PostgreSQL Flexible Server
postgres_server_name="devopsrg-postgres"
postgres_version="16"
postgres_sku_name="B_Standard_B1ms"
postgres_db_name="appdb"
postgres_admin_user="pgadmin"
postgres_admin_password="XXXXXX"